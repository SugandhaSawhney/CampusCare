# Copy to .env (project root). Everything is optional: the app runs fully without an AI key.
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true

# Optional LLM (any OpenAI-compatible API). Leave blank to use the deterministic fallback classifier.
OPENAI_API_KEY=
# LLM_API_KEY=            # alternative name; takes precedence if set
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning
SIMILARITY_THRESHOLD_FALLBACK=0.60
SIMILARITY_THRESHOLD_EMBEDDING=0.80
CLUSTER_WINDOW_DAYS=14
